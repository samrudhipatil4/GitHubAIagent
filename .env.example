PORT=3000
NODE_ENV=development
APP_NAME=AI GitHub Assistant
CLIENT_URL=http://localhost:5173

# GitHub OAuth (create at https://github.com/settings/developers)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:3000/api/v1/auth/github/callback

# Session (use a long random string in production)
SESSION_SECRET=change-this-to-a-random-secret-string

# AI (get Gemini key at https://aistudio.google.com/apikey)
GEMINI_API_KEY=
OPENAI_API_KEY=
AI_PROVIDER=gemini
AI_MODEL=gemini-2.0-flash

# MCP (Model Context Protocol) — routes AI tools through MCP layer
USE_MCP=true

# Rate limiting (requests per minute per user/IP)
RATE_LIMIT_MAX=100
