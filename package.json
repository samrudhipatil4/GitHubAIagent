{
  "name": "ai-github-assistant",
  "version": "1.0.0",
  "description": "AI-powered GitHub Assistant for managing repositories, PRs, issues, and workflows using natural language",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "dev:client": "npm run dev --prefix client",
    "dev:all": "concurrently \"npm run dev\" \"npm run dev:client\"",
    "build:client": "npm run build --prefix client"
  },
  "keywords": [
    "github",
    "ai",
    "assistant",
    "express",
    "gemini"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.19.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-session": "^1.19.0",
    "helmet": "^8.0.0",
    "morgan": "^1.10.0"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "nodemon": "^3.1.9"
  }
}
